# Set default behavior to automatically normalize line endings.
* text=auto

# Force Windows-only scripts to use CRLF line endings.
*.cmd           text eol=crlf
*.CMD           text eol=crlf
*.bat           text eol=crlf
*.BAT           text eol=crlf
*.ps1           text eol=crlf
*.PS1           text eol=crlf
*.vbs           text eol=crlf
*.VBS           text eol=crlf
*.wsf           text eol=crlf
*.WSF           text eol=crlf

# Force bash scripts to always use LF line endings so that if a repo is accessed
# in Unix via a file share from Windows, the scripts will work.
*.sh            text eol=lf


